{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist-host",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/host",
    "src/main",
    "src/shared"
  ],
  "exclude": [
    "src/main/__tests__",
    "src/shared/__tests__"
  ]
}
