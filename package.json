{
  "name": "paperstudio",
  "version": "1.0.0",
  "description": "论文工作台（Web）：检索/阅读/批注/方向/写作/演示 + 双后端 AI 助手（dsh 引擎 / EchoCap 平台网关）",
  "scripts": {
    "postinstall": "node scripts/fix-dsh-dupes.mjs",
    "dev": "npm run dev:server",
    "dev:renderer": "vite",
    "dev:server": "npm run build:host && node scripts/start-host.mjs",
    "build": "tsc --noEmit && vite build",
    "build:host": "tsc -p tsconfig.host.json",
    "verify:echocap": "node scripts/verify-echocap.mjs",
    "start": "npm run build:host && node scripts/start-host.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "^0.0.1-rc.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "better-sqlite3": "^12.0.0",
    "docx": "^9.0.0",
    "marked": "^18.0.13",
    "openai": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.0",
    "pptxgenjs": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
