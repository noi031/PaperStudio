{
  "name": "paperstudio",
  "version": "1.0.0",
  "description": "论文工作台：检索/阅读/批注/方向/写作/演示 + EchoCap AI 助手",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run rebuild && concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite",
    "build": "tsc --noEmit && vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "rebuild": "electron-rebuild -f -o better-sqlite3",
    "start": "npm run rebuild && electron .",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:watch": "npm rebuild better-sqlite3 && vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "better-sqlite3": "^12.0.0",
    "docx": "^9.0.0",
    "marked": "^18.0.13",
    "openai": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.0",
    "pptxgenjs": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
