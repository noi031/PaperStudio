{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron", "src/main", "src/shared"],
  "exclude": ["src/main/__tests__"]
}
